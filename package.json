{
  "name": "ai-powered-mock-interview-platform",
  "version": "1.0.0",
  "description": "PrepPilot - AI-Powered Mock Interview Platform",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "npm --prefix server install",
    "build:client": "npm --prefix client install && npm --prefix client run build",
    "build:server": "npm --prefix server install",
    "build": "npm --prefix client install && npm --prefix client run build && npm --prefix server install",
    "start": "node server/server.js",
    "server": "npm --prefix server start",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Sachin",
  "license": "ISC"
}
